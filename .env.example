# ─── Database ───────────────────────────────────
DATABASE_URL=file:./piplus.sqlite

# ─── Auth (generate with: openssl rand -base64 32) ─
AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3001

# ─── Server ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info
# Application version (used by web frontend)
APP_VERSION=0.2.5  # update on release, or leave empty for 'dev'

# ─── Production / Cloudflare Tunnel ───────────────
# Set this to your public URL to serve web + API together
# PUBLIC_WEB_ORIGIN=https://piplus.whosworld.fun
# CORS_ORIGINS=http://localhost:3002,https://piplus.whosworld.fun
# Comma-separated list of allowed origins. Overrides PUBLIC_WEB_ORIGIN for CORS.
# Set to * to allow all origins (e.g. for internal development).
# PIPLUS_WEB_DIST=./apps/web/dist

# ─── Web Dev Server SSL (optional) ────────────────
# 指向真实证书后，vite dev server 将使用它替代内置自签名证书（basic-ssl）。
# 两个变量需同时配置，且文件必须存在，否则回退到自签名证书。
# HTTPS_KEY_PATH=/path/to/private.key
# HTTPS_CERT_PATH=/path/to/fullchain.crt

# ─── Role prompts ─────────────────────────────────
# PIPLUS_FORCE_ROLE_PROMPTS=true
