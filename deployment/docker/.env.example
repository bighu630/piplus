# Piplus Docker 部署配置模板
#
# 用法：把本文件内容「追加」到项目根目录的 .env —— compose 只从项目根目录读 .env，
# 放在本目录（deployment/docker/）里不会被读取。
#
# ⚠️ 不要直接覆盖已有的根目录 .env：本地开发用的 .env 里通常还有
#    AUTH_SECRET / APP_PASSWORD / CORS_ORIGINS 等，覆盖会丢配置。
#
# 改完用下面这条命令复核插值结果（只解析、不启动、不拉镜像）：
#     docker compose config
#
# 这里列出的变量全部由 docker-compose.yml 的 ${VAR:-默认值} 消费。

# ── 对外访问地址 ───────────────────────────────────────────────
# 运行时生效，改完 `docker compose up -d` 重启容器即可，无需重建镜像。
# compose 默认值：piplus.whosworld.fun（不带协议时会按 https:// 归一化）
# 部署到自己的域名时必须改，否则前端页面与 API CORS 都指向错误的 origin。
PUBLIC_WEB_ORIGIN=https://your-domain.example.com

# ── 宿主数据目录 ───────────────────────────────────────────────
# 默认值与 docker-compose.yml 完全一致，因此照抄本文件不会改变现有挂载。
# 建议写绝对路径；Compose v2+ 也会展开 ~（本仓库用 `docker compose config` 实测通过）。
# 改错路径的表现是「历史数据不见了」，修改前请先确认目录存在且已有数据。
PI_AGENT_DIR=/data/piplus_data/pi/agent
PIPLUS_CONFIG_DIR=/data/piplus_data/piplus

# ── 宿主机监听端口（容器内固定 3000）────────────────────────────
# 默认 3008，即 3008:3000
PIPLUS_PORT=3008

# ── APP_VERSION：compose 不读取，仅用于「从源码构建」────────────────
# 拉取预构建镜像（docker compose pull）的部署方式下，修改本值没有任何效果：
# 版本号是构建期烘焙进镜像的，运行时无法更改。
#   · 发布流程 .github/workflows/build-release.yml 在打 tag 时从 tag 名推导版本
#     （${GITHUB_REF_NAME#v}），以 `docker build --build-arg APP_VERSION=<版本>` 传入；
#   · Dockerfile 中 `ARG APP_VERSION=dev` 是缺省值，随后 `ENV APP_VERSION=$APP_VERSION`
#     供 apps/web/vite.config.ts 在构建期写入前端常量 __APP_VERSION__。
# 因此从源码构建时推荐直接从 package.json 取值，避免手工同步：
#     docker build --build-arg APP_VERSION=$(jq -r '.version' apps/desktop/package.json) -t iambighu/piplus:latest .
# 下面这行的作用只是「记录当前版本号」，仅供参考，真实来源是 git tag。
APP_VERSION=0.3.1
